{
  "manifest_version": 3,
  "name": "{{storeTitle}}",
  "short_name": "{{shortName}}",
  "version": "{{version}}",
  "description": "{{description}}",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "{{name}}",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "permissions": ["declarativeNetRequest", "scripting", "storage"],
  "host_permissions": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
  "declarative_net_request": {
    "rule_resources": [
      { "id": "ad_rules", "enabled": true, "path": "rules/ads.json" }
    ]
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": [
        "brand.js",
        "content/settings.js",
        "content/overlay.js",
        "content/ads.js",
        "content/features/focus.js",
        "content/features/speed.js",
        "content/features/sponsor.js",
        "content/features/creators.js",
        "content/main.js"
      ],
      "css": ["styles/hide.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    }
  ]
}
